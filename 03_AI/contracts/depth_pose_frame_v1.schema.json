{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-layer.local/contracts/depth_pose_frame_v1.schema.json",
  "title": "NOVA Depth Pose Frame Bridge 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_number",
    "width",
    "height",
    "pose_model",
    "depth_model",
    "runtime",
    "joints"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "frame_number": { "type": "integer", "minimum": 0 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "pose_model": { "type": "string", "minLength": 1 },
    "depth_model": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "joints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "x", "y", "confidence", "depth_confidence"],
        "properties": {
          "label": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "depth_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "depth": { "type": ["number", "null"] }
        }
      }
    }
  }
}
